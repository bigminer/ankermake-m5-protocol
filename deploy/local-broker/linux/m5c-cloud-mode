#!/usr/bin/env bash
set -euo pipefail

CONFIG=/etc/m5c-local/network.conf
[[ $EUID -eq 0 ]] || { echo 'run with sudo' >&2; exit 1; }
[[ -r $CONFIG ]] || { echo "missing $CONFIG; run install.sh first" >&2; exit 1; }
# This root-owned file is generated by install.sh and contains interface/path
# values only, never Wi-Fi credentials.
# shellcheck disable=SC1090
source "$CONFIG"

MODE_FILE=/etc/m5c-local/mode.conf
MODE_STATE=/var/lib/m5c-local/network-mode
CLOUD_DROPIN=/etc/systemd/system/ankerctl.service.d/transport.conf

write_local_mode() {
  sed "s|@AP_ADDRESS@|$AP_ADDRESS|g" \
    /etc/m5c-local/mode-local.conf > "$MODE_FILE.new"
  chmod 0644 "$MODE_FILE.new"
  mv "$MODE_FILE.new" "$MODE_FILE"
  printf 'local\n' > "$MODE_STATE"
}

write_cloud_mode() {
  local resolvers dns_found=0 attempt
  for attempt in {1..60}; do
    resolvers=$(nmcli -g IP4.DNS device show "$UPLINK_INTERFACE" 2>/dev/null | tr '|' '\n')
    if grep -Eq '^[[:space:]]*([0-9]{1,3}\.){3}[0-9]{1,3}[[:space:]]*$' <<< "$resolvers"; then
      break
    fi
    sleep 1
  done
  : > /etc/m5c-local/mode.conf.new
  printf '# Cloud mode: pass DNS upstream and give the printer this host as gateway.\n' >> /etc/m5c-local/mode.conf.new
  printf 'dhcp-option=option:router,%s\n' "$AP_ADDRESS" >> /etc/m5c-local/mode.conf.new
  while IFS= read -r dns; do
    dns=${dns//[[:space:]]/}
    [[ $dns =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || continue
    printf 'server=%s\n' "$dns" >> /etc/m5c-local/mode.conf.new
    dns_found=1
  done <<< "$resolvers"
  (( dns_found == 1 )) || { echo "no upstream DNS found on $UPLINK_INTERFACE" >&2; rm -f /etc/m5c-local/mode.conf.new; return 1; }
  chmod 0644 /etc/m5c-local/mode.conf.new
  mv /etc/m5c-local/mode.conf.new "$MODE_FILE"
  printf 'cloud\n' > "$MODE_STATE"
}

apply_cloud() {
  [[ $UPLINK_INTERFACE != "$AP_INTERFACE" ]] || { echo 'uplink and AP interfaces must differ' >&2; return 1; }
  [[ -e /sys/class/net/$UPLINK_INTERFACE ]] || { echo "uplink is unavailable: $UPLINK_INTERFACE" >&2; return 1; }
  write_cloud_mode

  # Permit only the reserved printer to forward through the wired uplink.
  ufw route allow in on "$AP_INTERFACE" out on "$UPLINK_INTERFACE" \
    from "$PRINTER_ADDRESS" to any
  sysctl -q -w net.ipv4.ip_forward=1
  cat > /etc/sysctl.d/91-m5c-cloud-forwarding.conf <<'EOF'
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=0
EOF
  chmod 0644 /etc/sysctl.d/91-m5c-cloud-forwarding.conf

  nft delete table ip m5c_cloud_nat 2>/dev/null || true
  nft -f - <<NFT
table ip m5c_cloud_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr $PRINTER_ADDRESS oifname "$UPLINK_INTERFACE" masquerade
  }
}
NFT

  install -d -m 0755 /etc/systemd/system/ankerctl.service.d
  cat > "$CLOUD_DROPIN" <<EOF
[Service]
ExecStart=
ExecStart=$VENV_PYTHON $REPO_DIR/ankerctl.py webserver run --host 0.0.0.0 --port 4470
EOF
  chmod 0644 "$CLOUD_DROPIN"
}

apply_local() {
  write_local_mode
  ufw route delete allow in on "$AP_INTERFACE" out on "$UPLINK_INTERFACE" \
    from "$PRINTER_ADDRESS" to any >/dev/null 2>&1 || true
  nft delete table ip m5c_cloud_nat 2>/dev/null || true
  rm -f /etc/sysctl.d/91-m5c-cloud-forwarding.conf "$CLOUD_DROPIN"
  sysctl -q -w net.ipv4.ip_forward=0
  systemctl daemon-reload
}

bounce_ap() {
  nmcli connection down "$AP_CONNECTION" >/dev/null 2>&1 || true
  nmcli connection up "$AP_CONNECTION"
  systemctl restart m5c-ap-ready.service
}

case "${1:-status}" in
  cloud)
    systemctl enable m5c-cloud-mode.service >/dev/null
    systemctl start m5c-cloud-mode.service
    apply_cloud
    systemctl restart m5c-local-dnsmasq.service
    systemctl daemon-reload
    systemctl restart ankerctl.service
    bounce_ap
    systemctl restart m5c-local-dnsmasq.service
    ;;
  local)
    systemctl disable m5c-cloud-mode.service >/dev/null 2>&1 || true
    systemctl stop m5c-cloud-mode.service 2>/dev/null || true
    apply_local
    bounce_ap
    systemctl restart m5c-local-dnsmasq.service
    systemctl restart ankerctl.service
    ;;
  apply-cloud)
    apply_cloud
    ;;
  status)
    if [[ -r $MODE_STATE ]]; then cat "$MODE_STATE"; else echo local; fi
    ;;
  *)
    echo "usage: sudo $0 {cloud|local|status}" >&2
    exit 2
    ;;
esac
